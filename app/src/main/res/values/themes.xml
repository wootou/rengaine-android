<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Thème minimal d'avant Compose ; le vrai thème est ui/theme/Theme.kt. -->
    <style name="Theme.Rengaine" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- Écran de démarrage (U4) : monogramme sur le fond de l'app. -->
    <style name="Theme.Rengaine.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.Rengaine</item>
    </style>
</resources>
